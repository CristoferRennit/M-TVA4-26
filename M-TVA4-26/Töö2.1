vanus = input("Sisesta oma vanus:")
if not vanus.isdigit():
    print("Palun sisesta kehtiv vanus täisarvuna.")
else:
    vanus = int(vanus)
if vanus < 0 or vanus > 100:
    print("Viga andmetes, vanus peab olema 0 kuni 100")
elif vanus < 6:
    print("Pilet on tasuta.")
elif vanus <= 14:
    print("Lastepilet")
elif vanus <= 65:
    print("Täispilet")
elif vanus > 65:
    print("Sooduspilet")

else:
    print("Täna kinno ei minda.")
